# Copiar a .env (NO se versiona) y completar. Lo leen todos los servicios
# de docker-compose.yml. Usar las IP PRIVADAS de ec2-mq y ec2-kafka
# (172.31.x.x): no cambian al reiniciar el lab de AWS Academy.

# --- Web (HTTPS con Caddy) ---
# IP publica de ec2-apps con guiones + .sslip.io. Debe coincidir con la
# Redirect URI de Azure AD: https://<SITE_DOMAIN>
SITE_DOMAIN=100-53-6-28.sslip.io

# --- Memoria de cada JVM (9 servicios Java en la misma maquina) ---
JAVA_TOOL_OPTIONS=-Xms64m -Xmx256m -XX:MaxMetaspaceSize=160m -XX:+UseSerialGC

# --- Azure AD (Microsoft Entra ID) ---
AZURE_TENANT_ID=c75374e8-15d8-446b-8c6c-291120e0c761
AZURE_CLIENT_ID=6bf386f7-c08e-4ab9-88cd-57f56b590e66
AUTH_ISSUER_URI=https://login.microsoftonline.com/c75374e8-15d8-446b-8c6c-291120e0c761/v2.0

# --- Oracle (catalog, bookings, audit, report) ---
DB_HOST=
DB_PORT=1521
DB_SERVICE=
DB_USERNAME=
DB_PASSWORD=

# --- RabbitMQ en ec2-mq (catalog, bookings, notify, rabbitmq-admin) ---
RABBITMQ_HOST=172.31.x.x
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# --- Kafka en ec2-kafka (bookings, audit, report, kafka-admin) ---
KAFKA_BOOTSTRAP_SERVERS=172.31.x.x:9092
